{% extends 'base.html.twig' %}

{% block title %}Sign in — Pitlane{% endblock %}

{% block body %}
    <div class="flex min-h-[80vh] items-center justify-center">
        <div class="w-full max-w-sm rounded-lg border border-border bg-surface p-8">
            <h1 class="mb-6 flex items-center justify-center gap-2 text-xl font-semibold text-fg">
                <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full bg-brand"></span>
                Pitlane
            </h1>

            {% if error %}
                <div role="alert" class="mb-4 rounded-md border border-[#e10600]/40 bg-[#e10600]/15 px-4 py-3 text-sm text-[#ff8a85]">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="flex flex-col gap-4">
                <div>
                    <label for="inputEmail" class="mb-1.5 block text-sm text-muted">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" autocomplete="email" required autofocus
                           class="w-full rounded-md border border-border-strong bg-bg px-3 py-2 text-sm text-fg placeholder-muted/60">
                </div>

                <div>
                    <label for="inputPassword" class="mb-1.5 block text-sm text-muted">Password</label>
                    <input type="password" name="_password" id="inputPassword" autocomplete="current-password" required
                           class="w-full rounded-md border border-border-strong bg-bg px-3 py-2 text-sm text-fg placeholder-muted/60">
                </div>

                <label class="flex items-center gap-2 text-sm text-muted">
                    <input type="checkbox" name="remember_me" id="rememberMe" class="h-4 w-4 rounded border-border-strong bg-bg accent-brand">
                    Remember me for 30 days
                </label>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="w-full rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-fg hover:bg-brand-hover">
                    Sign in
                </button>
            </form>
        </div>
    </div>
{% endblock %}
