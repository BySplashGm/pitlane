{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "tmpDir": "var/infection",
    "timeout": 10,
    "threads": "max",
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection-log.json",
        "perMutator": "var/infection/per-mutator.md",
        "summaryJson": "var/infection/summary.json"
    },
    "testFramework": "phpunit",
    "staticAnalysisTool": "phpstan",
    "staticAnalysisToolOptions": "--memory-limit=1G",
    "minMsi": 100,
    "minCoveredMsi": 100,
    "ignoreMsiWithNoMutations": true,
    "mutators": {
        "@default": true
    }
}
