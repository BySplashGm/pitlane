{% extends 'base.html.twig' %}

{% block title %}{{ server.name }} · Pitlane{% endblock %}

{% block body %}
    {% set status_styles = {
        running: 'border-green-800 bg-green-950 text-green-300',
        stopped: 'border-border bg-surface text-muted',
        'not created': 'border-dashed border-border bg-surface text-muted',
        error: 'border-[#e10600]/40 bg-[#e10600]/15 text-[#ff8a85]',
        unknown: 'border-amber-800 bg-amber-950 text-amber-300',
    } %}

    <a href="{{ path('app_dashboard_index') }}" class="inline-flex items-center gap-1 text-sm font-medium text-muted hover:text-fg">
        <span aria-hidden="true">&larr;</span> Back to dashboard
    </a>

    <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
            <div class="flex items-center gap-3">
                <h1 class="truncate text-2xl font-semibold tracking-tight text-fg" title="{{ server.name }}">{{ server.name }}</h1>
                <span class="shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium capitalize {{ status_styles[status] ?? status_styles.unknown }}">
                    {{ status }}
                </span>
            </div>
            <p class="mt-1 truncate font-mono text-sm text-muted" title="{{ server.containerSlug }}">{{ server.containerSlug }}</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            {{ include('server/_controls.html.twig', {
                server: server,
                button_class: 'rounded-md border border-border px-3 py-1.5 text-sm font-medium text-fg hover:bg-surface-hover',
            }, with_context = false) }}
            {% if is_granted(constant('App\\Security\\Voter\\ServerVoter::EDIT'), server) %}
                <a href="{{ path('app_server_edit', {id: server.id}) }}" class="rounded-md border border-border px-3 py-1.5 text-sm font-medium text-fg hover:bg-surface-hover">
                    Edit
                </a>
            {% endif %}
            {% if is_granted(constant('App\\Security\\Voter\\ServerVoter::DELETE'), server) %}
                <button type="button" disabled class="cursor-not-allowed rounded-md border border-[#e10600]/40 px-3 py-1.5 text-sm font-medium text-[#ff8a85] opacity-50" title="Coming soon">
                    Delete
                </button>
            {% endif %}
        </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <section class="rounded-lg border border-border bg-surface p-4">
            <h2 class="text-lg font-semibold text-fg">Configuration</h2>
            <dl class="mt-3 space-y-2 text-sm">
                <div class="flex justify-between gap-4">
                    <dt class="text-muted">Track</dt>
                    <dd class="text-right text-fg">{{ server.track }}{% if server.trackLayout %} <span class="text-muted">· {{ server.trackLayout }}</span>{% endif %}</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted">Cars</dt>
                    <dd class="text-right text-fg">{{ server.cars|join(', ') }}</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted">Slots</dt>
                    <dd class="text-fg">{{ server.maxClients }}</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted">Session</dt>
                    <dd class="text-right text-fg capitalize">{{ server.sessionType.value }} · {{ server.sessionDuration }} {{ server.durationUnit.value }}</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted">Ports</dt>
                    <dd class="text-fg">TCP {{ server.tcpPort }} · UDP {{ server.udpPort }} · HTTP {{ server.httpPort }}</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted">Lobby</dt>
                    <dd class="text-fg">{{ server.registerToLobby ? 'Public (registered)' : 'Private (unlisted)' }}</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted">Password protected</dt>
                    <dd class="text-fg">{{ server.password is not empty ? 'Yes' : 'No' }}</dd>
                </div>
            </dl>
        </section>

        <section class="rounded-lg border border-border bg-surface p-4">
            <h2 class="text-lg font-semibold text-fg">Port exposure</h2>
            <ul class="mt-3 space-y-2 text-sm">
                {% set port_rows = [
                    { label: 'TCP', port: server.tcpPort, state: ports.tcp, checkable: true },
                    { label: 'UDP', port: server.udpPort, state: ports.udp, checkable: false },
                    { label: 'HTTP', port: server.httpPort, state: ports.http, checkable: true },
                ] %}
                {% for row in port_rows %}
                    <li class="flex items-center justify-between gap-4">
                        <span class="text-muted">{{ row.label }} {{ row.port }}</span>
                        {% if not row.checkable %}
                            {# UDP is connectionless: an outward probe can never tell open from closed.
                               Show it neutrally so it doesn't read as a recurring error. #}
                            <span class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs font-medium text-muted" title="UDP is connectionless, so reachability can't be probed from outside. This is expected, not an error.">Not probeable</span>
                        {% elseif row.state is null %}
                            <span class="rounded-full border border-amber-800 bg-amber-950 px-2.5 py-0.5 text-xs font-medium text-amber-300">⚠️ Unknown</span>
                        {% elseif row.state %}
                            <span class="rounded-full border border-green-800 bg-green-950 px-2.5 py-0.5 text-xs font-medium text-green-300">✅ Accessible</span>
                        {% else %}
                            <span class="rounded-full border border-[#e10600]/40 bg-[#e10600]/15 px-2.5 py-0.5 text-xs font-medium text-[#ff8a85]">❌ Blocked</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>

    <section class="mt-6 rounded-lg border border-border bg-surface p-4">
        <h2 class="text-lg font-semibold text-fg">Logs</h2>
        {% if status == 'running' %}
            <pre data-controller="server-logs" data-server-logs-url-value="{{ path('app_server_logs', { id: server.id }) }}" aria-label="Server logs" class="mt-3 max-h-96 overflow-auto rounded-md border border-border bg-bg p-3 font-mono text-xs leading-relaxed text-muted">Loading logs…</pre>
        {% else %}
            <p class="mt-3 text-sm text-muted">The server is not running. Logs are available once it starts.</p>
        {% endif %}
    </section>
{% endblock %}
