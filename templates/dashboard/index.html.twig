{% extends 'base.html.twig' %}

{% block title %}Dashboard · Pitlane{% endblock %}

{% block body %}
    <h1 class="text-2xl font-semibold tracking-tight text-fg">Dashboard</h1>

    {% set status_styles = {
        running: 'border-green-800 bg-green-950 text-green-300',
        stopped: 'border-border bg-surface text-muted',
        'not created': 'border-dashed border-border bg-surface text-muted',
        error: 'border-[#e10600]/40 bg-[#e10600]/15 text-[#ff8a85]',
        unknown: 'border-amber-800 bg-amber-950 text-amber-300',
    } %}

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-border bg-surface p-4">
            <p class="text-sm font-medium text-muted">Total servers</p>
            <p data-stat="total" class="mt-1 text-3xl font-semibold text-fg">{{ totalCount }}</p>
        </div>
        <div class="rounded-lg border border-border bg-surface p-4">
            <p class="text-sm font-medium text-muted">Running</p>
            <p data-stat="running" class="mt-1 text-3xl font-semibold text-green-400">{{ runningCount }}</p>
        </div>
        <div class="rounded-lg border border-border bg-surface p-4">
            <p class="text-sm font-medium text-muted">Stopped</p>
            <p data-stat="stopped" class="mt-1 text-3xl font-semibold text-fg">{{ stoppedCount }}</p>
        </div>
    </div>

    {% if servers is empty %}
        <div class="mt-6 rounded-lg border border-dashed border-border bg-surface px-4 py-12 text-center">
            <p class="text-lg font-medium text-fg">No servers yet</p>
            <p class="mt-1 text-sm text-muted">No Assetto Corsa servers are available to you.</p>
        </div>
    {% else %}
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {% for server in servers %}
                {% set status = statuses[server.id] ?? 'unknown' %}
                <article class="flex flex-col rounded-lg border border-border bg-surface p-4">
                    <div class="flex items-start justify-between gap-2">
                        <h2 class="truncate text-lg font-semibold text-fg" title="{{ server.name }}">{{ server.name }}</h2>
                        <span class="shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium capitalize {{ status_styles[status] ?? status_styles.unknown }}">
                            {{ status }}
                        </span>
                    </div>

                    <dl class="mt-3 space-y-1.5 text-sm">
                        <div class="flex justify-between gap-2">
                            <dt class="text-muted">Track</dt>
                            <dd class="truncate text-right text-fg" title="{{ server.track }}{% if server.trackLayout %} · {{ server.trackLayout }}{% endif %}">
                                {{ server.track }}{% if server.trackLayout %} <span class="text-muted">· {{ server.trackLayout }}</span>{% endif %}
                            </dd>
                        </div>
                        <div class="flex justify-between gap-2">
                            <dt class="text-muted">Max clients</dt>
                            <dd class="text-fg">{{ server.maxClients }}</dd>
                        </div>
                        <div class="flex justify-between gap-2">
                            <dt class="text-muted">Ports</dt>
                            <dd class="text-fg">TCP {{ server.tcpPort }} · UDP {{ server.udpPort }} · HTTP {{ server.httpPort }}</dd>
                        </div>
                    </dl>

                    <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-border pt-3">
                        {{ include('server/_controls.html.twig', {
                            server: server,
                            button_class: 'rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted hover:bg-surface-hover hover:text-fg',
                        }, with_context = false) }}
                        <a href="{{ path('app_server_show', { id: server.id }) }}" class="rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted hover:bg-surface-hover hover:text-fg">
                            View
                        </a>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
