{% extends 'base.html.twig' %}

{% block title %}New server · Pitlane{% endblock %}

{% macro field(field, label, help, attrs = {}) %}
    <div class="flex flex-col gap-1">
        {{ form_label(field, label, {label_attr: {class: 'text-sm font-medium text-fg'}}) }}
        {{ form_widget(field, {attr: {class: 'w-full rounded-md border border-border bg-bg px-3 py-2 text-sm text-fg placeholder:text-muted focus:border-brand focus:outline-none'}|merge(attrs)}) }}
        {% if help %}<p class="text-xs text-muted">{{ help }}</p>{% endif %}
        {{ form_errors(field) }}
    </div>
{% endmacro %}

{% macro toggle(field, label, help) %}
    <div class="flex flex-col gap-1">
        <label class="flex items-center gap-2 text-sm font-medium text-fg">
            {{ form_widget(field, {attr: {class: 'h-4 w-4 rounded border-border bg-bg text-brand focus:ring-brand'}}) }}
            {{ label }}
        </label>
        {% if help %}<p class="text-xs text-muted">{{ help }}</p>{% endif %}
        {{ form_errors(field) }}
    </div>
{% endmacro %}

{% block body %}
    {% import _self as ui %}

    <div class="mx-auto max-w-3xl">
        <div class="mb-6">
            <h1 class="text-2xl font-semibold tracking-tight text-fg">New server</h1>
            <p class="mt-1 text-sm text-muted">Configure a new Assetto Corsa dedicated server.</p>
        </div>

        {{ form_start(form, {attr: {class: 'flex flex-col gap-8'}}) }}
            {{ form_errors(form) }}

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Identification</legend>
                {{ ui.field(form.name, 'Name', 'Internal name; also used to derive the container slug.') }}
                {{ ui.field(form.serverName, 'Server name', 'Name shown to players in the in-game lobby.') }}
            </fieldset>

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Track</legend>
                {{ ui.field(form.track, 'Track', 'Only installed tracks are listed.', {'data-controller': 'symfony--ux-autocomplete--autocomplete'}) }}
                {{ ui.field(form.trackLayout, 'Track layout', 'Layouts of the selected track; optional.', {'data-controller': 'symfony--ux-autocomplete--autocomplete'}) }}
            </fieldset>

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Cars</legend>
                <div class="flex flex-col gap-2"
                     data-cars
                     data-cars-name="{{ form.cars.vars.full_name }}"
                     data-cars-options="{{ availableCars|json_encode|e('html_attr') }}">
                    <label for="cars-search" class="text-sm font-medium text-fg">Cars</label>
                    {# The rows are rendered by hand below; keep form_rest from re-emitting them as duplicate inputs. #}
                    {% do form.cars.setRendered %}
                    <div class="relative">
                        <input id="cars-search" type="search" data-cars-search autocomplete="off" placeholder="Search a car to add…"
                               role="combobox" aria-controls="cars-suggestions" aria-expanded="false" aria-autocomplete="list"
                               class="w-full rounded-md border border-border bg-bg px-3 py-2 text-sm text-fg placeholder:text-muted focus:border-brand focus:outline-none">
                        <ul id="cars-suggestions" role="listbox" aria-label="Installed cars" data-cars-suggestions
                            class="absolute z-10 mt-1 hidden max-h-56 w-full overflow-auto rounded-md border border-border bg-surface shadow"></ul>
                    </div>
                    <ul data-cars-list class="flex flex-col gap-2">
                        {% for car in form.cars %}
                            <li class="flex items-center gap-2" data-cars-row>
                                <span class="flex-1 rounded-md border border-border bg-bg px-3 py-2 text-sm text-fg">{{ car.vars.value }}</span>
                                <input type="hidden" name="{{ car.vars.full_name }}" value="{{ car.vars.value }}">
                                <button type="button" data-cars-remove class="rounded-md border border-border px-3 py-2 text-sm text-muted hover:bg-surface-hover hover:text-fg">Remove</button>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="text-xs text-muted">Search installed cars and add them; the same car can be added more than once.</p>
                    {{ form_errors(form.cars) }}
                </div>
            </fieldset>

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Access</legend>
                {{ ui.field(form.password, 'Join password', 'Leave blank for an open server.') }}
                {{ ui.field(form.adminPassword, 'Admin password', null) }}
                {{ ui.field(form.maxClients, 'Max clients', null, {min: 1, max: 64}) }}
            </fieldset>

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Ports</legend>
                <div class="grid gap-4 sm:grid-cols-3">
                    {{ ui.field(form.tcpPort, 'TCP port', null, {min: 1024, max: 65535}) }}
                    {{ ui.field(form.udpPort, 'UDP port', null, {min: 1024, max: 65535}) }}
                    {{ ui.field(form.httpPort, 'HTTP port', null, {min: 1024, max: 65535}) }}
                </div>
            </fieldset>

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Session</legend>
                {{ ui.field(form.sessionType, 'Session type', null) }}
                <div class="grid gap-4 sm:grid-cols-2">
                    {{ ui.field(form.sessionDuration, 'Session duration', null, {min: 1}) }}
                    {{ ui.field(form.durationUnit, 'Duration unit', null) }}
                </div>
            </fieldset>

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Weather</legend>
                {{ ui.field(form.weatherGraphics, 'Weather graphics', 'Installed weather presets.', {'data-controller': 'symfony--ux-autocomplete--autocomplete'}) }}
                <div class="grid gap-4 sm:grid-cols-2">
                    {{ ui.field(form.ambientTemp, 'Ambient temperature (°C)', 'Air temperature in °C, from 0 to 40.', {min: 0, max: 40}) }}
                    {{ ui.field(form.trackTemp, 'Track temperature (°C)', 'Track surface temperature in °C, from 0 to 55 — usually a few degrees above ambient.', {min: 0, max: 55}) }}
                </div>
            </fieldset>

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Dynamic track</legend>
                {{ ui.toggle(form.dynamicTrack, 'Dynamic track', 'Grip builds up over the session as cars lay rubber on the track. Check for an evolving surface; leave unchecked for constant grip.') }}
                {{ ui.field(form.trackGrip, 'Starting track grip (%)', 'Grip level at the start of the session, from 0 (green) to 100 (fully rubbered-in).', {min: 0, max: 100}) }}
            </fieldset>

            <fieldset class="flex flex-col gap-4 rounded-lg border border-border bg-surface p-5">
                <legend class="px-1 text-sm font-semibold uppercase tracking-wide text-muted">Options</legend>
                {{ ui.toggle(form.tcpNoDelay, 'TCP no delay', 'Sends network packets immediately instead of batching them, lowering latency at the cost of more traffic. Check unless you have a reason not to.') }}
                {{ ui.toggle(form.registerToLobby, 'Register to lobby', 'Lists the server on the public Assetto Corsa lobby so anyone can find and join it. Uncheck to keep it private.') }}
            </fieldset>

            <div class="flex items-center justify-end gap-3">
                <a href="{{ path('app_dashboard_index') }}" class="rounded-md border border-border px-4 py-2 text-sm font-medium text-muted hover:bg-surface-hover hover:text-fg">Cancel</a>
                <button type="submit" class="rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Create server</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script>
        (() => {
            const container = document.querySelector('[data-cars]');
            if (!container) {
                return;
            }

            const name = container.dataset.carsName;
            let options = [];
            try {
                options = JSON.parse(container.dataset.carsOptions);
            } catch (error) {
                options = [];
            }

            const search = container.querySelector('[data-cars-search]');
            const suggestions = container.querySelector('[data-cars-suggestions]');
            const list = container.querySelector('[data-cars-list]');
            let index = list.querySelectorAll('[data-cars-row]').length;

            // The car names currently shown as suggestions, and which one is keyboard-highlighted (-1 = none).
            let matches = [];
            let activeIndex = -1;

            const removeRow = (button) => button.closest('[data-cars-row]').remove();

            const addCar = (value) => {
                const row = document.createElement('li');
                row.className = 'flex items-center gap-2';
                row.setAttribute('data-cars-row', '');

                const label = document.createElement('span');
                label.className = 'flex-1 rounded-md border border-border bg-bg px-3 py-2 text-sm text-fg';
                label.textContent = value;

                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = `${name}[${index}]`;
                input.value = value;
                index += 1;

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.setAttribute('data-cars-remove', '');
                remove.className = 'rounded-md border border-border px-3 py-2 text-sm text-muted hover:bg-surface-hover hover:text-fg';
                remove.textContent = 'Remove';
                remove.addEventListener('click', () => removeRow(remove));

                row.append(label, input, remove);
                list.appendChild(row);
            };

            const closeSuggestions = () => {
                suggestions.replaceChildren();
                suggestions.classList.add('hidden');
                search.setAttribute('aria-expanded', 'false');
                search.removeAttribute('aria-activedescendant');
                matches = [];
                activeIndex = -1;
            };

            const highlight = (nextIndex) => {
                const items = suggestions.children;
                if (activeIndex >= 0 && items[activeIndex]) {
                    items[activeIndex].setAttribute('aria-selected', 'false');
                    items[activeIndex].classList.remove('bg-surface-hover');
                }

                activeIndex = nextIndex;

                if (activeIndex >= 0 && items[activeIndex]) {
                    const active = items[activeIndex];
                    active.setAttribute('aria-selected', 'true');
                    active.classList.add('bg-surface-hover');
                    active.scrollIntoView({block: 'nearest'});
                    search.setAttribute('aria-activedescendant', active.id);
                } else {
                    search.removeAttribute('aria-activedescendant');
                }
            };

            const pick = (value) => {
                addCar(value);
                search.value = '';
                closeSuggestions();
                search.focus();
            };

            const renderSuggestions = () => {
                const query = search.value.trim().toLowerCase();
                suggestions.replaceChildren();
                activeIndex = -1;
                search.removeAttribute('aria-activedescendant');

                // Empty query lists every installed car; typing filters it. The list scrolls (max-h-56).
                matches = query === '' ? options.slice() : options.filter((option) => option.toLowerCase().includes(query));
                if (matches.length === 0) {
                    suggestions.classList.add('hidden');
                    search.setAttribute('aria-expanded', 'false');
                    return;
                }

                matches.forEach((match, matchIndex) => {
                    const option = document.createElement('li');
                    option.id = `cars-option-${matchIndex}`;
                    option.setAttribute('role', 'option');
                    option.setAttribute('aria-selected', 'false');
                    option.className = 'cursor-pointer px-3 py-2 text-sm text-fg hover:bg-surface-hover';
                    option.textContent = match;
                    option.addEventListener('mouseenter', () => highlight(matchIndex));
                    // mousedown (not click) so the pick registers before the search input's blur closes the list.
                    option.addEventListener('mousedown', (event) => {
                        event.preventDefault();
                        pick(match);
                    });
                    suggestions.appendChild(option);
                });

                suggestions.classList.remove('hidden');
                search.setAttribute('aria-expanded', 'true');
            };

            search.addEventListener('input', renderSuggestions);
            search.addEventListener('focus', renderSuggestions);
            search.addEventListener('blur', () => window.setTimeout(closeSuggestions, 100));

            search.addEventListener('keydown', (event) => {
                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    if (matches.length === 0) {
                        renderSuggestions();
                    } else {
                        highlight((activeIndex + 1) % matches.length);
                    }
                } else if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    if (matches.length > 0) {
                        highlight((activeIndex - 1 + matches.length) % matches.length);
                    }
                } else if (event.key === 'Enter' && activeIndex >= 0) {
                    // Only intercept Enter when a suggestion is highlighted, so the form still submits otherwise.
                    event.preventDefault();
                    pick(matches[activeIndex]);
                } else if (event.key === 'Escape') {
                    closeSuggestions();
                }
            });

            list.querySelectorAll('[data-cars-remove]').forEach((button) => {
                button.addEventListener('click', () => removeRow(button));
            });
        })();
    </script>
{% endblock %}
