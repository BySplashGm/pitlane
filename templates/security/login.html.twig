{% extends 'base.html.twig' %}

{% block title %}Sign in — Pitlane{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            color-scheme: dark;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f1115;
            color: #e6e8eb;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 360px;
            padding: 2rem;
            background: #171a21;
            border: 1px solid #262b35;
            border-radius: 10px;
        }

        .login-card h1 {
            margin: 0 0 1.5rem;
            font-size: 1.25rem;
            text-align: center;
        }

        .login-card label {
            display: block;
            margin-bottom: 0.35rem;
            font-size: 0.85rem;
            color: #a7adba;
        }

        .login-card input[type="email"],
        .login-card input[type="password"] {
            width: 100%;
            box-sizing: border-box;
            padding: 0.6rem 0.75rem;
            margin-bottom: 1rem;
            background: #0f1115;
            border: 1px solid #2c313c;
            border-radius: 6px;
            color: #e6e8eb;
            font-size: 0.95rem;
        }

        .login-card .remember {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
            font-size: 0.85rem;
            color: #a7adba;
        }

        .login-card .remember input {
            margin: 0;
        }

        .login-card button {
            width: 100%;
            padding: 0.65rem;
            background: #e10600;
            border: none;
            border-radius: 6px;
            color: #fff;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
        }

        .login-card button:hover {
            background: #c40500;
        }

        .login-card .error {
            margin-bottom: 1rem;
            padding: 0.6rem 0.75rem;
            border-radius: 6px;
            background: rgba(225, 6, 0, 0.15);
            border: 1px solid rgba(225, 6, 0, 0.4);
            color: #ff8a85;
            font-size: 0.85rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="login-card">
        <h1>Pitlane</h1>

        {% if error %}
            <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <label for="inputEmail">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" autocomplete="email" required autofocus>

            <label for="inputPassword">Password</label>
            <input type="password" name="_password" id="inputPassword" autocomplete="current-password" required>

            <label class="remember">
                <input type="checkbox" name="remember_me" id="rememberMe">
                Remember me for 30 days
            </label>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Sign in</button>
        </form>
    </div>
{% endblock %}
