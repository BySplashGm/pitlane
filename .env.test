# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Docker/orchestration knobs the service container resolves at build time. The functional tests
# never reach a real daemon (DockerServiceInterface is stubbed, or the call degrades gracefully),
# so these only need to be defined, not reachable.
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=pitlane
AC_SERVERS_DIR=./var/ac-servers
AC_CONTENT_DIR=./var/ac-content
